{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vjovanov/fissile/schema/audit.schema.json",
  "title": "fissile audit output",
  "description": "`fissile audit --format json` (FS-004-check-audit.2): standing findings plus optional inventory sections. `top` appears with --top, `stale` and `loose` with --stale-exceptions, and `coverage` with --rule-coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "silenced",
    "exceptions"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "description": "Standing findings, same shape as check output.",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "silenced": {
      "type": "array",
      "description": "Overflows accepted by an exception, carried for attribution (FS-003-exceptions.5).",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "exceptions": {
      "type": "object",
      "description": "Registry entries per kind across both registries (FS-004-check-audit.2): accepted permanently versus carrying debt. Always present, including all-zero.",
      "additionalProperties": false,
      "required": [
        "structural",
        "deferred"
      ],
      "properties": {
        "structural": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "top": {
      "type": "array",
      "description": "Largest files per unit (audit --top N).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "files"
        ],
        "properties": {
          "unit": {
            "type": "string",
            "enum": [
              "bytes",
              "lines",
              "tokens"
            ]
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "path"
              ],
              "properties": {
                "value": {
                  "type": "integer",
                  "minimum": 0
                },
                "path": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "stale": {
      "type": "array",
      "description": "Exceptions whose path matches no scanned file (audit --stale-exceptions). An entry is identified by the registry it lives in and the path it accepts, since the list spans both registries (DF-005-exception-identity).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry",
          "path"
        ],
        "properties": {
          "registry": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "loose": {
      "type": "array",
      "description": "Exact-path exceptions whose ceiling stands more than one [exceptions.bump] step above the file they accept (audit --stale-exceptions, FS-003-exceptions.7). Stale is the other half: an entry accepting a file that is gone.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "registry",
          "path",
          "severity",
          "unit",
          "accepted",
          "actual",
          "limit",
          "retune_to",
          "stated_range",
          "silences_nothing"
        ],
        "properties": {
          "registry": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "soft",
              "hard"
            ],
            "description": "Which registry holds the entry, and therefore which of the rule's two limits it accepts."
          },
          "unit": {
            "type": "string",
            "enum": [
              "bytes",
              "lines",
              "tokens"
            ]
          },
          "accepted": {
            "type": "integer",
            "minimum": 0,
            "description": "The ceiling the entry records."
          },
          "actual": {
            "type": "integer",
            "minimum": 0,
            "description": "What the file measures now."
          },
          "limit": {
            "type": "integer",
            "minimum": 0,
            "description": "The rule limit at that severity — what the entry exists to accept, and the floor `retune_to` never drops below."
          },
          "retune_to": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "description": "The ceiling `fissile exception retune` would write, never below the limit the entry accepts. Null where the step would land a soft ceiling on the hard limit and `retune` refuses it (DF-010-stated-ceilings-are-exact.2); `stated_range` carries the remedy instead."
          },
          "stated_range": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "min",
              "max_excluded"
            ],
            "description": "The range a stated ceiling may take when `retune_to` is null: the file's current size up to, excluding, the hard limit. Null whenever `retune_to` holds a value — exactly one of the two is ever set.",
            "properties": {
              "min": {
                "type": "integer",
                "minimum": 0
              },
              "max_excluded": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "silences_nothing": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 when the file no longer crosses that limit at all, so removing the entry is the remedy rather than lowering it."
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Rule coverage gaps (audit --rule-coverage).",
      "additionalProperties": false,
      "required": [
        "unmatched_rules",
        "catch_all_only",
        "unused_messages"
      ],
      "properties": {
        "unmatched_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "catch_all_only": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unused_messages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
